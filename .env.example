# Copy this file to .env and replace every value marked "change-me".
KEYCLOAK_ADMIN_USERNAME=change-me-admin
KEYCLOAK_ADMIN_PASSWORD=change-me-admin-password
REVEX_ADMIN_PASSWORD=change-me-realm-admin-password
REVEX_USER_PASSWORD=change-me-realm-user-password
REVEX_MODERATOR_PASSWORD=change-me-realm-moderator-password
POSTGRES_DB=revex_history
POSTGRES_USER=revex
POSTGRES_PASSWORD=change-me-postgres-password

# Kafka: ten days retention in milliseconds
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=content-changes
KAFKA_RETENTION_MS=864000000
