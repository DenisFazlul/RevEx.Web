<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.103.1" />
    <PackageReference Include="MongoDB.Driver" Version="3.5.2" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageReference Include="Confluent.Kafka" Version="2.6.1" />
    <PackageReference Include="Npgsql" Version="8.0.6" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RevEx.Application\RevEx.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Data/SeedFiles/Door-Single-Glass-Push-Plate.rfa"
                      LogicalName="RevEx.SeedFiles.Door-Single-Glass-Push-Plate.rfa" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../RevEx.Domain/src/RevEx.Domain/RevEx.Domain.csproj" Condition="'$(UseRevExDomainPackage)' != 'true'" />
    <PackageReference Include="RevEx.Domain" Version="1.1.0" Condition="'$(UseRevExDomainPackage)' == 'true'" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../RevEx.Domain/src/RevEx.Contracts/RevEx.Contracts.csproj" Condition="'$(UseRevExDomainPackage)' != 'true'" />
    <PackageReference Include="RevEx.Contracts" Version="1.0.0" Condition="'$(UseRevExDomainPackage)' == 'true'" />
  </ItemGroup>
</Project>
