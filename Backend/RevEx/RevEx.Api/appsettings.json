{
  "DesktopReleases": {
    "Path": "storage/desktop-releases",
    "MaximumExpandedBytes": 2147483648
  },
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "revex"
  },
  "ContentHistory": {
    "ConnectionString": ""
  },
  "Authentication": {
    "Provider": "Keycloak",
    "Providers": {
      "Keycloak": {
        "Authority": "http://localhost:8081/realms/revex",
        "Audience": "revex-api",
        "RequireHttpsMetadata": false
      },
      "ActiveDirectory": {}
    }
  },
  "FileStorage": {
    "Provider": "NetworkFolder",
    "NetworkFolder": {
      "Path": "storage/files"
    },
    "S3": {
      "ServiceUrl": "https://storage.yandexcloud.net",
      "Region": "ru-central1",
      "BucketName": "",
      "AccessKey": "",
      "SecretKey": "",
      "KeyPrefix": "revex/files"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "NotificationService": {
    "Host": "localhost",
    "Port": 587,
    "EnableSsl": true,
    "Username": "",
    "Password": "",
    "FromAddress": "noreply@example.com",
    "FromName": "RevEx"
  }
}
