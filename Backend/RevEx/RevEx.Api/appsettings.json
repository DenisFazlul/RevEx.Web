{
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "revex"
  },
  "Authentication": {
    "Provider": "Keycloak",
    "Providers": {
      "Keycloak": {
        "Authority": "http://localhost:8081/realms/revex",
        "Audience": "revex-api",
        "RequireHttpsMetadata": false
      },
      "ActiveDirectory": {}
    }
  },
  "FileStorage": {
    "Provider": "NetworkFolder",
    "NetworkFolder": {
      "Path": "storage/files"
    },
    "S3": {
      "ServiceUrl": "https://storage.yandexcloud.net",
      "Region": "ru-central1",
      "BucketName": "",
      "AccessKey": "",
      "SecretKey": "",
      "KeyPrefix": "revex/files"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
