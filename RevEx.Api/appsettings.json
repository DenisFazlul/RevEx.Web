{
  "Authentication": {
    "Provider": "Keycloak",
    "Providers": {
      "Keycloak": {
        "Authority": "http://localhost:8081/realms/revex",
        "Audience": "revex-api",
        "RequireHttpsMetadata": false
      },
      "ActiveDirectory": {}
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
